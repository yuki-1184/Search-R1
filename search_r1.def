Bootstrap: docker
From: nvidia/cuda:12.1.1-devel-ubuntu22.04

%labels
    Author Search-R1
    Description Search-R1 environment for ABCI / HPC clusters

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export PATH=/opt/conda/bin:$PATH
    export CUDA_HOME=/usr/local/cuda
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export PYTHONNOUSERSITE=1

%post
    # ── System packages ──
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        curl \
        wget \
        ca-certificates \
        swig \
        pkg-config \
        libgomp1 \
        libopenblas-dev \
        libjpeg-dev \
        libpng-dev \
        && rm -rf /var/lib/apt/lists/*

    # ── Miniforge (Python 3.10, conda-forge only — no Anaconda TOS) ──
    wget -q https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -O /tmp/miniforge.sh
    bash /tmp/miniforge.sh -b -p /opt/conda
    rm /tmp/miniforge.sh
    export PATH=/opt/conda/bin:$PATH
    conda install -y python=3.10
    conda clean -afy

    # ── Pin numpy<2 globally via constraint so no package can override it ──
    echo "numpy<2" > /tmp/constraints.txt
    export PIP_CONSTRAINT=/tmp/constraints.txt

    # ── Build tools from pip to avoid old distro versions (Ubuntu 22.04 has cmake 3.22) ──
    pip install --no-cache-dir "cmake>=3.23.1"

    # ── setuptools (needed for pkg_resources used by torch) ──
    pip install --no-cache-dir "setuptools>=69"

    # ── vllm (installs matching torch automatically) ──
    pip install --no-cache-dir "vllm==0.6.3"

    # ── Build FAISS GPU from source with explicit CUDA architectures ──
    # Update FAISS_CUDA_ARCHS to match your target GPUs when needed.
    export FAISS_CUDA_ARCHS="80;86;89;90"
    rm -rf /tmp/faiss
    git clone --depth 1 --branch v1.8.0 https://github.com/facebookresearch/faiss.git /tmp/faiss
    cmake -S /tmp/faiss -B /tmp/faiss/build \
        -DFAISS_ENABLE_GPU=ON \
        -DFAISS_ENABLE_PYTHON=ON \
        -DBUILD_TESTING=OFF \
        -DFAISS_OPT_LEVEL=generic \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CUDA_ARCHITECTURES="${FAISS_CUDA_ARCHS}" \
        -DPython_EXECUTABLE=/opt/conda/bin/python
    cmake --build /tmp/faiss/build --target faiss -j"$(nproc)"
    cmake --build /tmp/faiss/build --target swigfaiss -j"$(nproc)"
    pip install --no-cache-dir /tmp/faiss/build/faiss/python
    rm -rf /tmp/faiss

    # ── flash-attn (source build — matching the torch version pulled by vllm) ──
    export CUDA_HOME=/usr/local/cuda
    pip install --no-cache-dir flash-attn --no-build-isolation

    # ── Other Search-R1 dependencies ──
    pip install --no-cache-dir \
        accelerate \
        codetiming \
        datasets \
        dill \
        hydra-core \
        pandas \
        pybind11 \
        ray \
        "tensordict<0.6" \
        "transformers<4.48" \
        wandb \
        IPython \
        matplotlib

    # ── Remove constraint file ──
    rm /tmp/constraints.txt
    unset PIP_CONSTRAINT

    # ── Install verl (Search-R1) in editable mode at runtime ──
    # The project directory will be bind-mounted, so we skip install here.

    # ── Cleanup ──
    pip cache purge
    conda clean -afy

%runscript
    exec python "$@"
